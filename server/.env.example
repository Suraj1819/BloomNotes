# ---------------------------------------------------------------------------
# BloomNotes backend environment
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# Supabase (service role key — NEVER expose to the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase anon key (used to verify user tokens)
SUPABASE_ANON_KEY=your-anon-key

# Supabase JWT secret (OPTIONAL but recommended for performance).
# Found in: Supabase Dashboard > Project Settings > API > JWT Secret
# When set, the backend verifies access tokens locally instead of calling
# Supabase Auth on every request — drops request latency from ~600ms to ~5ms.
SUPABASE_JWT_SECRET=your-jwt-secret

# 24-hour inactivity session config (milliseconds)
SESSION_TTL_MS=86400000
SESSION_ACTIVITY_DEBOUNCE_MS=60000

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Vault upload limits
VAULT_MAX_FILE_SIZE=26214400
